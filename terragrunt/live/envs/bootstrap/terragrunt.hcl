# # Generate provider configuration
generate "providers" {
  path      = "providers.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
terraform {
  required_version = ">= 1.0"
  
  required_providers {
    oci = {
      source  = "oracle/oci"
      version = ">= 5.0.0"
    }
    doppler = {
      source  = "DopplerHQ/doppler"
      version = ">= 1.0.0"
    }
  }
}

# # OCI Provider
provider "oci" {
  tenancy_ocid = "${local.tenancy_ocid}"
  user_ocid    = "${include.common.locals.user_ocid}"
  fingerprint  = "${include.common.locals.fingerprint}"
  private_key  = <<KEY
${include.common.locals.private_key}
KEY
  region       = "${local.region}"
}

# Doppler Provider
provider "doppler" {
  doppler_token = "${include.root.locals.doppler_service_token}" == "placeholder-token" ? null : "${include.root.locals.doppler_service_token}"
}
EOF
} 