# Bootstrap Module Configuration
# This module creates the foundational infrastructure including:
# - Terraform users and groups
# - IAM policies (including Cloud Guard permissions)
# - Compartments
# - Tag namespaces
# - KMS vault and keys
# - TFState buckets
# - Doppler secrets

# Include common configuration
include "common" {
  path   = find_in_parent_folders("env-common.hcl")
  expose = true
}

# Include root configuration for additional inputs
include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

# Terraform configuration
terraform {
  source = "../../../../terraform/modules/oci/bootstrap"
}

# Local variables
locals {
  # Environment configuration from env-common.hcl
  environments_to_bootstrap = include.common.locals.environments_to_bootstrap
  
  # Common configuration
  name_prefix = include.common.locals.name_prefix
  region      = include.common.locals.region
  tenancy_ocid = include.common.locals.tenancy_ocid
  
  # Doppler configuration
  doppler_project = include.root.inputs.doppler_project
  
  # Common tags
  common_tags = merge(
    include.root.inputs.common_tags,
    {
      Environment = "bootstrap"
      Module      = "bootstrap"
    }
  )
}

# Inputs for the bootstrap module
inputs = {
  # Required variables
  tenancy_ocid = local.tenancy_ocid
  region       = local.region
  
  # Environment configuration
  environments = local.environments_to_bootstrap
  
  # Doppler configuration
  doppler_project = local.doppler_project
  
  # Parent compartment (use tenancy root for bootstrap)
  parent_compartment_ocid = local.tenancy_ocid
  
  # KMS configuration
  kms_key_id = ""  # Let the module create KMS resources
  create_kms_resources = true
  kms_rotation_period_days = 90
  
  # Tag namespace configuration
  tag_namespace_name = "koci"
  
  # Common tags
  common_tags = local.common_tags
  
  # Compartment protection
  allow_compartment_destroy = false
  
  # Name prefix
  name_prefix = local.name_prefix
}

# Generate backend configuration for bootstrap
# Bootstrap uses local backend since it creates the remote state infrastructure
remote_state {
  backend = "local"
  config = {}
  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }
}

